<%- include('../layout/base', { header: true, title: 'Register' }) %>

<div class="auth-wrapper" id="register-container">
  <div class="auth-card" id="register-form-card">
    <div class="auth-header">
      <h1 id="register-heading">Student Registration</h1>
      <p>Create an account to start tracking your grades</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" role="alert" id="register-error-alert">
        <%= error %>
      </div>
    <% } %>

    <form action="/register" method="POST" id="form-register-inputs">
      <div class="form-group">
        <label for="username">Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          class="form-control" 
          value="<%= typeof username !== 'undefined' ? username : '' %>" 
          required 
          placeholder="3 to 20 characters"
          minlength="3"
          maxlength="20"
        >
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="form-control" 
          required 
          placeholder="Minimum 6 characters"
          minlength="6"
        >
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input 
          type="password" 
          id="confirmPassword" 
          name="confirmPassword" 
          class="form-control" 
          required 
          placeholder="Repeat your password"
          minlength="6"
        >
      </div>

      <button type="submit" class="btn btn-primary" id="btn-register-submit" style="margin-top: 0.5rem;">Register</button>
    </form>

    <div class="auth-footer">
      <p>Already have an account? <a href="/login" id="link-goto-login">Log in here</a></p>
    </div>
  </div>
</div>

<%- include('../layout/base', { header: false }) %>
